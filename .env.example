OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Replace with your actual OpenAI API key
# You can obtain an API key from https://platform.openai.com/signup
AI_PROVIDER=openai
# Supported values: openai or gemini
OPENAI_MODEL=gpt-4o-mini
# Optional: override OpenAI model used by chat completions

GEMINI_API_KEY=ai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Replace With your actual Gemini API key

# Voice chat timing tuning (optional)
VOICE_CHAT_STT_LISTEN_SECONDS=10
VOICE_CHAT_STT_PAUSE_SECONDS=3
VOICE_CHAT_MAX_SILENT_TURNS=2
VOICE_CHAT_LOOP_DELAY_MS=250
VOICE_CHAT_PAUSED_POLL_MS=250
VOICE_CHAT_DEFAULT_SPEECH_SPEED_X=1.5
